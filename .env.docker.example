# Dedicated Environment File Template for Docker Containers
# Copy this file to .env.docker before running docker compose:
#   cp .env.docker.example .env.docker
# NEVER commit .env.docker to version control.

RUNNING_IN_DOCKER=1
DEBUG=True
SECRET_KEY=django-insecure-docker-geommand-local-dev-key
DB_HOST=db
DB_PORT=5432
DB_NAME=land_records
DB_USER=landuser
DB_PASSWORD=landpassword
GEOMMAND_ENV=demo
ALLOWED_HOSTS=*
