# GEOMMAND Backend — Environment Variables Template
# Copy this file to .env and populate with real values before running.
# NEVER commit .env to version control.

# ── Django Core ──────────────────────────────────────────────────────────────
SECRET_KEY=django-insecure-replace-this-with-a-real-50-char-random-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database (PostGIS) ────────────────────────────────────────────────────────
DB_NAME=land_records
DB_USER=landuser
DB_PASSWORD=landpassword
DB_HOST=localhost
DB_PORT=5432

# ── GeoDjango Native Libraries ────────────────────────────────────────────────
# Linux/Docker: leave unset — Django auto-discovers system libraries.
# Windows (QGIS dev environment): set to the full path of the DLL.
# Example for QGIS 4.0.1:
#   GDAL_LIBRARY_PATH=C:\Program Files\QGIS 4.0.1\bin\gdal312.dll
#   GEOS_LIBRARY_PATH=C:\Program Files\QGIS 4.0.1\bin\geos_c.dll
GDAL_LIBRARY_PATH=
GEOS_LIBRARY_PATH=

# ── TNGIS Integration ─────────────────────────────────────────────────────────
# Set to False once official API credentials are obtained from CLA/TNeGA.
TNGIS_DEMO_MODE=True
# TNGIS_API_KEY=

# ── Object Storage (MinIO / AWS S3) ──────────────────────────────────────────
# Required for TD-01: Migrate photos from PostgreSQL JSONField to object store.
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=geommand-photos

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOW_ALL_ORIGINS=True
